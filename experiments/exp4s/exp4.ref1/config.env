# Experiment 4: fixed routes; only receiver compute tails vary across DAGs.
EXPERIMENT_NAME="exp4.ref1"
EXPERIMENT_DESCRIPTION="DAG-1: all-minimal reference"
FLOW_PATTERN="A: 0->2, B: 1->3; two simultaneous 32 KiB flows with receiver compute tails"
ROUTING=SOURCE
SENDER_CC_ALGO=nscc
LOAD_BALANCING_ALGO=mixed
PATH_ENTROPY_SIZE=64
QUEUE_PACKETS=88
CWND_BYTES=0
WORKLOAD=workload/exp4s/exp4.dag1/workload.bin
TOPOLOGY="${SCRIPT_DIR}/../topology/p3a1h2"
BINARY=htsim/sim/build/datacenter/htsim_uec_df
RANK_PLACEMENT_CONFIG="${SCRIPT_DIR}/../rank_placement.json"
MESSAGELET_CONFIG="${SCRIPT_DIR}/../messagelet_configs/default.json"
ROUTING_CONFIG="${SCRIPT_DIR}/routing_configs/default.json"
BUILD_IF_MISSING=1
TRACE_FLOW_COMPLETIONS=1
TRACE_PACKET_HOPS=1
SLACK_READY_WINDOW_NS=100
SIM_EXTRA_ARGS=()
