# Experiment 3.a baseline configuration.
# This file is sourced by run.sh, so use shell-compatible KEY=VALUE syntax.

EXPERIMENT_NAME="exp3.a"
EXPERIMENT_DESCRIPTION="Experiment 3 baseline with concurrent collectives and no injected delay"
FLOW_PATTERN="ranks 0-3 ring all-reduce; ranks 4-7 tree all-reduce; ranks 8-11 direct all-to-all"

# Dragonfly and UEC settings.
ROUTING=SOURCE
SENDER_CC_ALGO=nscc
LOAD_BALANCING_ALGO=mixed
PATH_ENTROPY_SIZE=64
QUEUE_PACKETS=88
CWND_BYTES=0

# Paths are resolved relative to the repository root unless absolute.
WORKLOAD=workload/exp3s/exp3.a/workload.bin
TOPOLOGY="${SCRIPT_DIR}/topology/p6a1h2"
BINARY=htsim/sim/build/datacenter/htsim_uec_df
RANK_PLACEMENT_CONFIG="${SCRIPT_DIR}/rank_placement.json"
MESSAGELET_CONFIG="${SCRIPT_DIR}/messagelet_configs/default.json"
ROUTING_CONFIG="${SCRIPT_DIR}/routing_configs/default.json"

BUILD_IF_MISSING=1
TRACE_FLOW_COMPLETIONS=1
SLACK_READY_WINDOW_NS=100

# Add optional simulator flags here, for example: SIM_EXTRA_ARGS=(-sender_cc_only)
SIM_EXTRA_ARGS=()
