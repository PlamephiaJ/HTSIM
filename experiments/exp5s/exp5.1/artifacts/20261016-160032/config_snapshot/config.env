# Messagelet-level network-only load balancing baseline on exp2.a.2 inputs.
EXPERIMENT_NAME="exp5.1"
EXPERIMENT_DESCRIPTION="UGAL-L messagelet load balancing baseline on the exp2.a.2 collective DAG"
FLOW_PATTERN="ranks 0-3 ring all-reduce; ranks 4-7 tree all-reduce; ranks 8-11 direct all-to-all"

# SOURCE executes the route selected once by the runtime's UGAL-L policy.
ROUTING=SOURCE
SENDER_CC_ALGO=nscc
LOAD_BALANCING_ALGO=mixed
PATH_ENTROPY_SIZE=64
QUEUE_PACKETS=88
CWND_BYTES=0

WORKLOAD=workload/exp2s/exp2a1_collective_internal_slack/workload.bin
TOPOLOGY="${SCRIPT_DIR}/topology/p6a1h2"
BINARY=htsim/sim/build/datacenter/htsim_uec_df
RANK_PLACEMENT_CONFIG="${SCRIPT_DIR}/rank_placement.json"
MESSAGELET_CONFIG="${SCRIPT_DIR}/messagelet_configs/default.json"
# Static flow routing would override/conflict with the network policy.
ROUTING_CONFIG=""
REFERENCE_EXPERIMENT=experiments/exp2s/exp2.a.2

BUILD_IF_MISSING=1
BUILD_BEFORE_RUN=1
BUILD_JOBS=4
TRACE_FLOW_COMPLETIONS=1
SLACK_READY_WINDOW_NS=100
SIM_EXTRA_ARGS=()
