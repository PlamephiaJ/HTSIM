# Experiment 1 configuration.
# This file is sourced by run.sh, so use shell-compatible KEY=VALUE syntax.

# Metadata used by summary.md. Keep values quoted when they contain spaces.
EXPERIMENT_NAME="exp1.2"
EXPERIMENT_DESCRIPTION="Dragonfly minimal-path contention with DAG level delay. Medium 10 us."
RANK_PLACEMENT="ranks 0,1,2 -> group 0; ranks 3,4,5 -> group 1; group 2 -> two-hop alternative"
FLOW_PATTERN="0->3, 1->4, 2->5 (concurrent)"

# Dragonfly routing: MINIMAL, VALIANT, or UGAL_L.
# MINIMAL makes all three flows contend on the direct group-0 -> group-1 link.
# UGAL_L may instead use group 2 as a two-global-hop path.
ROUTING=MINIMAL

# UEC transport and multipath settings.
SENDER_CC_ALGO=nscc
LOAD_BALANCING_ALGO=mixed
PATH_ENTROPY_SIZE=64
QUEUE_PACKETS=88
CWND_BYTES=0

# Shared input paths are resolved relative to the repository root unless absolute.
# Keep experiment-owned inputs relative to SCRIPT_DIR so this directory is relocatable.
WORKLOAD=workload/exp1.2/workload.bin
TOPOLOGY="${SCRIPT_DIR}/topology/p3a1h2"
BINARY=htsim/sim/build/datacenter/htsim_uec_df

# Build htsim_uec_df automatically when BINARY does not exist.
BUILD_IF_MISSING=1

# Emit flow-completion records to simulator.log for quick inspection.
TRACE_FLOW_COMPLETIONS=1

# Add optional simulator flags here, for example: SIM_EXTRA_ARGS=(-sender_cc_only)
SIM_EXTRA_ARGS=()
